import character hanna from "characters/hanna.json"
import character mccauley from "characters/mccauley.json"
import set diner-night from "sets/diner-night.svg"
import prop diner-table from "props/diner-table.svg"
import prop coffee-cup from "props/coffee-cup.svg"

config {
  width: 1280
  height: 720
  fps: 24
  background: #171416
}

// Fictionalized, dialogue-free diner tribute. All 9 poses specify the 24 fields accepted by this DSL.

