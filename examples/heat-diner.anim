scene "establish" (duration: 10s, set: diner-night) {
  place mccauley at (0.30, 0.72) facing right layer 1
  place diner-table at (0.50, 0.77) layer 2
  mccauley pose "waiting"
  camera wide
  wait 2s
  camera medium mccauley
  wait 1.5s
  camera zoom-to mccauley over 1s ease-in-out
  wait 2s
  camera wide
  wait 2.5s
  transition fade-black 1s
}

scene "hanna-arrives" (duration: 12s, set: diner-night) {
  place mccauley at (0.30, 0.72) facing right layer 1
  // Enter from the right so the walk never crosses McCauley and trips overlap detection.
  place hanna at (0.95, 0.72) facing left layer 1
  place diner-table at (0.50, 0.77) layer 2
  mccauley pose "waiting"
  hanna pose "rise"
  camera wide
  together {
    hanna moves-to (0.68, 0.72) over 4s ease-out
    camera pan-to (0.52, 0.54) over 4s ease-in-out
  }
  camera zoom-to hanna over 1s ease-in-out
  wait 1s
  camera two-shot
  wait 3s
  camera wide
  wait 2.5s
  transition fade-black 0.5s
}

scene "the-table" (duration: 20s, set: diner-night) {
  place mccauley at (0.30, 0.72) facing right layer 1
  place hanna at (0.70, 0.72) facing left layer 1
  place diner-table at (0.50, 0.77) layer 2
  place coffee-cup at (0.43, 0.70) layer 3
  mccauley pose "waiting"
  hanna pose "settling"
  camera two-shot
  wait 3s
  camera zoom-to hanna over 1s ease-in-out
  hanna pose "talking"
  wait 3s
  camera zoom-to mccauley over 1s ease-in-out
  mccauley pose "listening"
  wait 3s
  camera two-shot
  wait 3s
  camera zoom-to hanna over 1s ease-in-out
  hanna pose "lean-in"
  wait 2s
  camera wide
  wait 2.5s
  transition fade-black 0.5s
}

scene "the-exchange" (duration: 28s, set: diner-night) {
  place mccauley at (0.30, 0.72) facing right layer 1
  place hanna at (0.70, 0.72) facing left layer 1
  place diner-table at (0.50, 0.77) layer 2
  place coffee-cup at (0.43, 0.70) layer 3
  camera two-shot
  mccauley pose "answering"
  wait 1s
  camera zoom-to mccauley over 1s ease-in-out
  wait 2s
  camera zoom-to hanna over 1s ease-in-out
  hanna pose "listening"
  wait 2s
  hanna pose "talking"
  wait 4s
  camera zoom-to mccauley over 1s ease-in-out
  mccauley pose "sip-coffee"
  together {
    coffee-cup moves-to (0.39, 0.59) over 1s ease-out
    do {
      wait 2s
      coffee-cup moves-to (0.43, 0.70) over 1s ease-in-out
    }
  }
  camera zoom-to hanna over 1s ease-in-out
  hanna pose "lean-in"
  wait 3s
  camera zoom-to mccauley over 1s ease-in-out
  mccauley pose "listening"
  wait 2s
  camera two-shot
  wait 5s
  transition fade-black 1s
}

scene "parting" (duration: 16s, set: diner-night) {
  place mccauley at (0.30, 0.72) facing right layer 1
  place hanna at (0.68, 0.72) facing left layer 1
  place diner-table at (0.50, 0.77) layer 2
  mccauley pose "listening"
  hanna pose "rise"
  camera two-shot
  wait 3s
  camera wide
  // Step into the back aisle before crossing the frame, keeping the two figures separated.
  hanna moves-to (0.68, 0.46) over 1s ease-in-out
  hanna exits left over 3s ease-in
  camera zoom-to mccauley over 1s ease-in-out
  mccauley pose "alone"
  wait 6s
  transition fade-black 2s
}
