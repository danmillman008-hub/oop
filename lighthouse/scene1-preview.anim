scene "scene-1-10s-preview" (duration: 10s, set: lighthouse-interior) {
  place kai at (0.56, 0.72) facing up layer 1
  place red-scarf at (0.56, 0.58) layer 2
  camera wide
  kai pose "gazing"
  wait 1s
  together {
    camera zoom-to kai over 7s ease-in-out
    do {
      wait 1s
      kai pose "watching"
    }
  }
  wait 2s
}
